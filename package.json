{
  "name": "git-visual",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node agent/cli.mjs start",
    "stop": "node agent/cli.mjs stop",
    "status": "node agent/cli.mjs status",
    "test": "node --test agent/test/*.test.mjs",
    "format:check": "npx prettier --check frontend agent package.json README.md"
  }
}
